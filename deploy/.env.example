# ---- Hearth 自托管中央配置 ----
# 复制为 .env 后修改：cp .env.example .env

# 对外域名（仅 caddy profile 需要：Caddy 自动签证书，需 80/443 公网可达）
DOMAIN=livekit.example.com

# LiveKit API 密钥对（hearth server 与 livekit 两方必须一致）
LIVEKIT_API_KEY=hearth
LIVEKIT_API_SECRET=change-me-livekit-secret

# STUN 服务器（公共默认值；国内部署推荐 stun.miwifi.com:3478）
STUN_SERVER=stun.l.google.com:19302

# WebRTC 媒体端口（映射到宿主机，防火墙/安全组需放行）
RTC_UDP_PORT=47882
RTC_TCP_PORT=47881

# hearth 对外 HTTP 端口（Web/API/信令/WHIP 代理都走它）
HEARTH_PORT=8080

# 容器网络内部端口（一般无需修改）
LIVEKIT_PORT=7880

# ---- 数据库（可选）----
# 空 = sqlite（容器内 /data 卷）；切换 MySQL/Postgres 示例：
# DATABASE_URL=mysql://user:pass@host:3306/hearth
# DATABASE_URL=postgres://user:pass@host:5432/hearth
# DATABASE_URL=

# ---- 浏览器可见地址（可选）----
# 不设置时 hearth 按请求自动推导同源地址（/providers/{alias} 信令/WHIP 经内置反代），一般无需设置；
# 使用外部域名 + caddy profile 时可显式指定：
# LIVEKIT_URL=wss://livekit.example.com
