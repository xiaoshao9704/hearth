# LiveKit Ingress 配置（由 init.sh 从 deploy/.env 生成，勿手改 generated/ 产物）
# 只用 WHIP：RTMP 关闭；WHIP bypass 转码（hearth 创建 ingress 时 enable_transcoding=false）
api_key: ${LIVEKIT_API_KEY}
api_secret: ${LIVEKIT_API_SECRET}
ws_url: ws://livekit:${LIVEKIT_PORT}
redis:
  address: redis:6379
whip_port: ${WHIP_PORT}
rtmp_port: -1
cpu_cost:
  rtmp_cpu_cost: 2
  whip_cpu_cost: 2
  whip_bypass_transcoding_cpu_cost: 0.1
  url_cpu_cost: 2
