# 自包含镜像（CI 纯装配，产物已在 runner 上交叉编译好，见 release 工作流）。
# 两个 target：
#   livekit → hearth + livekit-server（投屏/摄像头全功能），distroless，~110MB
#   full    → 再加 redis + ingress（OBS WHIP 推流），基于 livekit/ingress 官方镜像（含 GStreamer）
# 标准档（纯 hearth）用 Dockerfile.release。
# 进程编排：/app/aioinit（PID 1，见 server/cmd/aioinit）——按 EMBED_* 环境变量拉起子服务。
# 基础镜像均可经 build-arg 整体替换（私有 registry / 镜像加速场景），版本钉死在默认值里。
ARG LIVEKIT_IMAGE=livekit/livekit-server:v1.13.6
ARG INGRESS_IMAGE=livekit/ingress:v1.5.0
ARG DISTROLESS_IMAGE=gcr.io/distroless/static-debian12:nonroot

FROM ${LIVEKIT_IMAGE} AS lk

# ---- -livekit 档 ----
FROM ${DISTROLESS_IMAGE} AS livekit
ARG TARGETARCH
COPY --from=lk /livekit-server /app/livekit-server
COPY --chmod=755 out/aioinit-linux-${TARGETARCH} /app/aioinit
COPY --chmod=755 out/hearth-linux-${TARGETARCH} /app/hearth
COPY web/dist /app/web
COPY --chown=65532:65532 out/data /data
ENV ADDR=:8080 \
    DB_PATH=/data/hearth.db \
    STATIC_DIR=/app/web \
    EMBED_LIVEKIT=1 \
    LIVEKIT_PORT=7880 \
    LIVEKIT_TCP_PORT=7881 \
    LIVEKIT_UDP_PORT=7882
VOLUME /data
USER 65532
EXPOSE 8080 7880 7881 7882/udp
ENTRYPOINT ["/app/aioinit"]

# ---- -full 档 ----
FROM ${INGRESS_IMAGE} AS full
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends redis-server \
    && rm -rf /var/lib/apt/lists/*
COPY --from=lk /livekit-server /app/livekit-server
COPY --chmod=755 out/aioinit-linux-${TARGETARCH} /app/aioinit
COPY --chmod=755 out/hearth-linux-${TARGETARCH} /app/hearth
COPY web/dist /app/web
RUN mkdir -p /data
ENV ADDR=:8080 \
    DB_PATH=/data/hearth.db \
    STATIC_DIR=/app/web \
    EMBED_LIVEKIT=1 \
    EMBED_INGRESS=1 \
    LIVEKIT_PORT=7880 \
    LIVEKIT_TCP_PORT=7881 \
    LIVEKIT_UDP_PORT=7882 \
    INGRESS_WHIP_PORT=7888 \
    INGRESS_UDP_PORT=7885 \
    INGRESS_TCP_PORT=7886
VOLUME /data
EXPOSE 8080 7880 7881 7882/udp 7888 7885/udp 7886
ENTRYPOINT ["/app/aioinit"]
