# HTTP 监听地址
ADDR=:8080

# ---- 数据库 ----
# 默认 sqlite（无需设置 DATABASE_URL，用 DB_PATH 指定文件即可）
DB_PATH=hearth.db
# 切换 MySQL / Postgres 示例：
# DATABASE_URL=mysql://user:pass@localhost:3306/hearth
# DATABASE_URL=postgres://user:pass@localhost:5432/hearth

# ---- 媒体内核（LiveKit）----
# 默认不需要配置任何 env：语音与舞台选择器默认都是内建 lkembed（补丁式 fork 的 LiveKit，
# 跑在本进程内，无 redis、无 ingress，密钥留空自动生成落库），语音/投屏/OBS 推流开箱可用。
# 只有接入一个独立部署的外部 LiveKit（而非本进程内嵌）时才需要下面这组 env：设置后启动时
# 自动合成 alias=livekit 的锁定服务实例（管理后台「服务实例」里只读展示）；都不配也可以在
# 后台注册 DB 实例（同类型可多个，alias 自定）。
# 服务端调 LiveKit Twirp API 的地址（也是 /providers/livekit 信令代理的上游）
# LIVEKIT_API_URL=http://localhost:7880
# LIVEKIT_API_KEY=hearth
# LIVEKIT_API_SECRET=change-me-livekit-secret

# 浏览器可见的 LiveKit WSS 地址；留空 = 按请求推导同源 /providers/livekit 信令代理地址（推荐）
# LIVEKIT_URL=wss://livekit.example.com

# ---- 注册策略 ----
# closed（只能 CLI 开号）/ invite（管理员发邀请链接，默认）/ open（任何人可注册）
# 管理后台里改过之后以后台设置为准（落库），这里只是初始默认值
# REG_POLICY=invite
# 站点公开地址（拼邀请链接用）；留空 = 按请求推导同源
# PUBLIC_URL=https://hearth.example.com

# 允许的跨域来源（vite 开发服务器地址；生产同源部署可留 *）
CORS_ORIGIN=http://localhost:5173

# 可选：托管前端构建产物目录（部署时一个二进制搞定）
# STATIC_DIR=../web/dist
