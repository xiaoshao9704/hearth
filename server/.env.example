# HTTP 监听地址
ADDR=:8080

# ---- 数据库 ----
# 默认 sqlite（无需设置 DATABASE_URL，用 DB_PATH 指定文件即可）
DB_PATH=hearth.db
# 切换 MySQL / Postgres 示例：
# DATABASE_URL=mysql://user:pass@localhost:3306/hearth
# DATABASE_URL=postgres://user:pass@localhost:5432/hearth

# ---- LiveKit 接入 ----
# 说明：LiveKit / Ingress 相关项也可以不在这里配——留空时管理员可在
# 「管理后台 → 服务参数」里填写（落库，保存即生效）；这里设置了则以环境为准，后台只读。
# 服务端调 LiveKit Twirp API 的地址（也是内置 /lk/ 代理的上游）
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=hearth
LIVEKIT_API_SECRET=change-me-livekit-secret

# 浏览器可见的 LiveKit WSS 地址；留空 = 按请求推导同源 /lk 代理地址（推荐）
# LIVEKIT_URL=wss://livekit.example.com/lk

# ---- Ingress（OBS WHIP 推流，可选）----
# WHIP 上游（内置 /w/ 代理目标）；留空 = Ingress 未启用（/api/ingress 返回 503）
# INGRESS_UPSTREAM_URL=http://localhost:58080
# 浏览器可见的 WHIP 基地址；留空 = 按请求推导同源 /w/ 代理地址
# INGRESS_PUBLIC_URL=https://livekit.example.com/w/

# ---- 注册策略 ----
# closed（只能 CLI 开号）/ invite（管理员发邀请链接，默认）/ open（任何人可注册）
# 管理后台里改过之后以后台设置为准（落库），这里只是初始默认值
# REG_POLICY=invite
# 站点公开地址（拼邀请链接用）；留空 = 按请求推导同源
# PUBLIC_URL=https://hearth.example.com

# 允许的跨域来源（vite 开发服务器地址；生产同源部署可留 *）
CORS_ORIGIN=http://localhost:5173

# 可选：托管前端构建产物目录（部署时一个二进制搞定）
# STATIC_DIR=../web/dist
