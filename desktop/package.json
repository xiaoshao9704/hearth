{
  "name": "hearth-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "bundle:mac": "bash scripts/bundle-gst-macos.sh",
    "sidecar:mac": "bash scripts/build-sidecar.sh",
    "build:mac": "npm run sidecar:mac && tauri build --bundles app && npm run bundle:mac",
    "setup:windows": "pwsh -NoProfile -File scripts/setup-gst-windows.ps1",
    "bundle:windows": "pwsh -NoProfile -File scripts/bundle-gst-windows.ps1",
    "build:windows": "npm run bundle:windows && tauri build --target x86_64-pc-windows-msvc --bundles nsis -- --locked",
    "test:windows": "pwsh -NoProfile -File scripts/test-bundle-windows.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
